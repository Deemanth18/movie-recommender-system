# MovieClaw - Environment Variables
# Copy this file to .env and fill in your keys

# ────────────────────────────────────────────────────
# TMDB API Key (free) — for movie posters
# Get yours: https://www.themoviedb.org/settings/api
# ────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ────────────────────────────────────────────────────
# Telegram Bot Token (free) — for messaging
# Create bot: https://t.me/botfather → /newbot
# ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ────────────────────────────────────────────────────
# LLM — No key needed!
# MovieClaw uses OpenRouter free models via OpenClaw.
# Default: Meta Llama 3.3 70B (free)
# Fallback: Google Gemma 3 27B (free)
# ────────────────────────────────────────────────────

# ────────────────────────────────────────────────────
# OPTIONAL: Google AI Studio Gemini key
# If you have one, you can use Gemini instead
# Get yours: https://aistudio.google.com/apikey
# ────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
